<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<settings>

    <!-- Account: login/logout/import visibility uses relative eq() on username -->
    <category label="30000">
        <setting id="username" type="text" label="30001" default="" enable="false"/>
        <setting id="action_login" type="action" label="30002" action="RunScript(script.dejavu,action=login)" option="close" visible="eq(-1,)"/>
        <setting id="action_logout" type="action" label="30003" action="RunScript(script.dejavu,action=logout)" option="close" visible="!eq(-2,)"/>
        <setting id="action_import_kodi" type="action" label="30120" action="RunScript(script.dejavu,action=import_kodi)" option="close" visible="!eq(-3,)"/>
        <setting id="enable_context_menu" type="bool" label="30175" default="true"/>
        <setting id="access_token" type="text" label="30099" default="" visible="false"/>
        <setting id="kodi_import_offered" type="bool" default="false" visible="false"/>
        <setting id="kodi_import_at" type="text" default="" visible="false"/>
    </category>

    <!-- Import Kodi library — no enable= on hidden token (Kodi greys it out) -->
    <category label="30120">
        <setting id="import_kodi_help" type="lsep" label="30173"/>
        <setting id="action_import_kodi_tab" type="action" label="30120" action="RunScript(script.dejavu,action=import_kodi)" option="close"/>
    </category>

    <!-- Scrobbling -->
    <category label="30010">
        <setting id="enable_scrobble" type="bool" label="30011" default="true"/>
        <setting id="watched_percent" type="number" label="30013" default="90"/>
        <setting id="show_notifications" type="bool" label="30014" default="true"/>
        <setting id="prompt_rating" type="bool" label="30070" default="true"/>
        <setting id="enable_resume" type="bool" label="30071" default="true"/>
        <setting id="enable_upnext" type="bool" label="30072" default="true"/>
        <setting id="sync_kodi_library" type="bool" label="30106" default="true"/>
    </category>

    <!-- Advanced -->
    <category label="30020">
        <setting id="scrobble_interval" type="number" label="30012" default="30"/>
        <setting id="tmdb_api_key" type="text" label="TMDB API Key" default="" visible="false"/>
        <setting id="api_url" type="text" label="30021" default="https://dejavu.plus/api/v1"/>
        <setting id="debug" type="bool" label="30022" default="false"/>
    </category>

</settings>
